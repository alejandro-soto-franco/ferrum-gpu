# manylinux_2_28_x86_64 base + CUDA Toolkit 13.x + Rust 1.99.1 + the
# cuda-oxide codegen backend + maturin. Used to build the public PyPI wheel.
#
# Build:   docker build -f crates/ferrum-gpu-py/Dockerfile.manylinux \
#                       -t ferrum-gpu-builder:latest crates/ferrum-gpu-py
# Run:     docker run --rm -v $(pwd):/work -w /work \
#                       ferrum-gpu-builder:latest \
#                       /work/crates/ferrum-gpu-py/build-wheel.sh
#
# Notes:
# - The image is ~6-8 GB. Build time ~15-25 minutes from scratch.
# - GPU at build time is NOT required. The build-wheel.sh script sets
#   CUDA_OXIDE_TARGET=sm_80 so cuda-oxide emits PTX (ISA 7.0) that the runtime
#   driver JITs to native SASS on any Ampere-or-newer GPU. Do NOT use a
#   compute_* target: cuda-oxide emits a stale `.version 3.2` directive for
#   compute_* targets, which ptxas rejects ("PTX .version 3.2 does not support
#   .target ...") and the wheel fails its first FFT with DriverError 218.
#   Add `--gpus all` only if you want to run `cargo oxide doctor`
#   inside the container interactively.
# - Output wheel lands in /work/dist/ tagged manylinux_2_28_x86_64. Verify
#   with `auditwheel show dist/*.whl`.
# - The wheel does NOT bundle libcudart; users must have an NVIDIA driver
#   that supports CUDA 13.x (driver 580+). cudarc dynamic-loads libcuda
#   at runtime.

FROM quay.io/pypa/manylinux_2_28_x86_64:latest

# Pin rustc to the release cuda-oxide pins.
ENV RUSTUP_HOME=/root/.rustup CARGO_HOME=/root/.cargo
ENV PATH="/root/.cargo/bin:${PATH}"

# Install CUDA Toolkit 13.x via NVIDIA's cuda-keyring rpm.
RUN dnf -y install dnf-plugins-core && \
    dnf config-manager --add-repo \
      https://developer.download.nvidia.com/compute/cuda/repos/rhel9/x86_64/cuda-rhel9.repo && \
    dnf -y install cuda-toolkit-13-1 && \
    dnf clean all

ENV PATH="/usr/local/cuda/bin:${PATH}" \
    LD_LIBRARY_PATH="/usr/local/cuda/lib64:${LD_LIBRARY_PATH:-}" \
    CUDA_HOME=/usr/local/cuda

# libclang for bindgen (cuda-oxide's cargo-oxide build depends on it via
# bindgen; without it `cargo install cargo-oxide` panics: "Unable to find
# libclang"). clang-devel ships libclang.so on the manylinux_2_28 (AlmaLinux 8)
# base.
RUN dnf -y install clang clang-devel llvm-devel && dnf clean all
ENV LIBCLANG_PATH=/usr/lib64

# Install Rust 1.99.1 + components. llvm-tools provides the `llc` that
# cuda-oxide prefers for PTX.
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | \
      sh -s -- -y --default-toolchain 1.99.1 \
        --component rust-src --component rustc-dev --component llvm-tools \
        --component clippy

# Build the cuda-oxide codegen backend from NVIDIA/cuda-rust at the revision
# the workspace's cuda-device, cuda-host and cuda-core pin (Cargo.toml). The
# backend must come from the same revision as those crates and be built by
# the same rustc that loads it. cuda-oxide/rust-toolchain.toml pins 1.99.1,
# and cuda-oxide/.cargo/config.toml sets RUSTC_BOOTSTRAP=1 for rustc_private.
# The wheel's RUSTFLAGS point maturin at the resulting .so (see
# build-wheel.sh), staged at the conventional cache path.
ARG CUDA_RUST=https://github.com/NVIDIA/cuda-rust.git
ARG CUDA_RUST_REV=9df9e7cef561e03a066230b3bb433b3d8285da81
RUN git init -q /opt/cuda-rust && cd /opt/cuda-rust && \
    git fetch -q --depth 1 ${CUDA_RUST} ${CUDA_RUST_REV} && \
    git checkout -q FETCH_HEAD && \
    cd cuda-oxide/crates/rustc-codegen-cuda && \
    cargo build && \
    mkdir -p /root/.cargo/cuda-oxide && \
    cp target/debug/librustc_codegen_cuda.so \
       /root/.cargo/cuda-oxide/librustc_codegen_cuda.so

# Install maturin + patchelf.
RUN /opt/python/cp310-cp310/bin/pip install --no-cache-dir maturin patchelf

ENV MATURIN=/opt/python/cp310-cp310/bin/maturin

# Default to a shell; the user invokes maturin via the build-wheel.sh
# script or directly.
WORKDIR /work
CMD ["bash"]
